# Program to find the Longest Common Subsequence (LCS)
# using Dynamic Programming (Tabulation)

def lcs_length_table(str1, str2):
    m, n = len(str1), len(str2)
    dp = [[0] * (n + 1) for _ in range(m + 1)]

    # Fill DP table
    for i in range(1, m + 1):
        for j in range(1, n + 1):
            if str1[i - 1] == str2[j - 1]:
                dp[i][j] = dp[i - 1][j - 1] + 1
            else:
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])
    return dp


def reconstruct_lcs(str1, str2, dp):
    i, j = len(str1), len(str2)
    lcs = []

    while i > 0 and j > 0:
        if str1[i - 1] == str2[j - 1]:
            lcs.append(str1[i - 1])
            i -= 1
            j -= 1
        elif dp[i - 1][j] >= dp[i][j - 1]:
            i -= 1
        else:
            j -= 1

    return "".join(reversed(lcs))


# Main Program
sequence1 = input("Enter the first sequence: ")
sequence2 = input("Enter the second sequence: ")

dp_table = lcs_length_table(sequence1, sequence2)
lcs = reconstruct_lcs(sequence1, sequence2, dp_table)
length = dp_table[len(sequence1)][len(sequence2)]

print("\nDP Table:")
for row in dp_table:
    print(row)

print("\nLongest Common Subsequence:", lcs)
print("Length of LCS:", length)




