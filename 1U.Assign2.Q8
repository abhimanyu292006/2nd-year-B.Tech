# Movie Collection Management System

class Movie:
    def __init__(self, name, rating, ticket_price, category):
        self.name = name
        self.rating = rating
        self.ticket_price = ticket_price
        self.category = category  # "Hit", "Average", "Flop"

    def __str__(self):
        return f"Movie: {self.name}, Rating: {self.rating}, Price: ₹{self.ticket_price}, Category: {self.category}"


class Cinema:
    def __init__(self):
        self.movies = []

    def add_movie(self, movie):
        self.movies.append(movie)

    def display_movies(self):
        if not self.movies:
            print("No movies in the collection.")
        else:
            print("\n--- Cinema Movie Collection ---")
            for m in self.movies:
                print(m)


# Example usage
if __name__ == "__main__":
    # Create cinema object
    cinema = Cinema()

    # Add movies
    cinema.add_movie(Movie("Inception", 9.0, 250, "Hit"))
    cinema.add_movie(Movie("The Room", 3.0, 100, "Flop"))
    cinema.add_movie(Movie("Interstellar", 8.5, 300, "Hit"))
    cinema.add_movie(Movie("Average Joe", 5.5, 150, "Average"))

    # Display all movie details
    cinema.display_movies()




#OUTPUT
--- Cinema Movie Collection ---
Movie: Inception, Rating: 9.0, Price: ₹250, Category: Hit
Movie: The Room, Rating: 3.0, Price: ₹100, Category: Flop
Movie: Interstellar, Rating: 8.5, Price: ₹300, Category: Hit
Movie: Average Joe, Rating: 5.5, Price: ₹150, Category: Average
